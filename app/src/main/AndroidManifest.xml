<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- أذونات الموقع الجغرافي والخرائط -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- أذونات الكاميرا والاتصال -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- مفتاح جوجل ماب -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAqXeOqrnhLZ_5FEczEbk7VoAJrGpFus24" />

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/login_title"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize" />
            
        <activity
            android:name=".CaptainRegisterActivity"
            android:exported="false"
            android:label="@string/captain_register_title"
            android:theme="@style/Theme.MyApplication" />
            
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:label="@string/admin_dashboard_title"
            android:theme="@style/Theme.MyApplication" />
            
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="@string/chat_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name="com.yalla.meshwar.ChatActivity"
            android:exported="false"
            android:label="@string/chat_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name="com.yalla.meshwar.CaptainRegisterActivity"
            android:exported="false"
            android:label="@string/captain_register_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name="com.yalla.meshwar.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />
    </application>

</manifest>
